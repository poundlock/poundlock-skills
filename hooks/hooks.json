{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "delegation"
            ],
            "timeout": 30,
            "statusMessage": "校验派发白名单…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "readiness"
            ],
            "timeout": 30,
            "statusMessage": "校验前置产物…"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "writepath"
            ],
            "timeout": 30,
            "statusMessage": "校验写路径归属…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "contract"
            ],
            "timeout": 30,
            "statusMessage": "校验契约保护…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "rework"
            ],
            "timeout": 30,
            "statusMessage": "校验返工预算…"
          }
        ]
      },
      {
        "matcher": "^(Skill|SendMessage|ListAgents|EnterWorktree|Workflow)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "pm-tools"
            ],
            "timeout": 30,
            "statusMessage": "校验项目经理会话的工具…"
          }
        ]
      },
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "handback"
            ],
            "timeout": 30,
            "statusMessage": "校验交回…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "stop-gate"
            ],
            "timeout": 30,
            "statusMessage": "校验交付物…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "deliverable"
            ],
            "timeout": 30,
            "statusMessage": "记录交付物校验…"
          }
        ]
      },
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "handback-sent"
            ],
            "timeout": 30,
            "statusMessage": "记录交回…"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "ledger"
            ],
            "timeout": 30,
            "statusMessage": "回传契约哈希与触达表…"
          }
        ]
      },
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "approval-ask"
            ],
            "timeout": 30,
            "statusMessage": "记录批准…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'poundlock reminder: this line is only for the poundlock project manager session (one where the user ran /poundlock:at, at-tweak, at-resume, at-init or at-skills, or one started with --agent poundlock:at-pm; /poundlock:at-status does not count); any other session ignores it. Project manager: before the first Agent dispatch or the first write under .poundlock in this turn, run the gate self-check from your role file. If the role file is no longer in your context, Write .poundlock/gate-check with any text first: the refusal says where the role file is; read it in full. If that write is not refused, the gate is not running: stop and tell the user. Earlier results do not count: this session may have been resumed in another process.'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "approval-prompt"
            ],
            "timeout": 30,
            "statusMessage": "核对返工批准…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "completion"
            ],
            "timeout": 30,
            "statusMessage": "核对子代理交付…"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^poundlock:(at|at-tweak)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "user-words"
            ],
            "timeout": 30,
            "statusMessage": "记下需求原话…"
          }
        ]
      },
      {
        "matcher": "^poundlock:(at|at-resume|at-status|at-tweak)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "session-notice"
            ],
            "timeout": 30,
            "statusMessage": "核对这一趟归哪个会话…"
          }
        ]
      },
      {
        "matcher": "^poundlock:(at|at-tweak|at-resume|at-init|at-skills)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "pm-session"
            ],
            "timeout": 30,
            "statusMessage": "记下项目经理会话…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "pm-compact"
            ],
            "timeout": 30,
            "statusMessage": "记下上下文压缩…"
          }
        ]
      }
    ]
  }
}
